# ──────────────────────────────────────────────
#  Medical Image Dataset Monitor — Environment
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is for LOCAL development only.
# For GitHub Actions, add these as Repository Secrets instead.

# Kaggle API Credentials
# Get from: https://www.kaggle.com/settings → "API" section → "Create New Token"
# This downloads a kaggle.json with your username and key.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Slack Incoming Webhook URL
# Get from: https://api.slack.com/messaging/webhooks
# 1. Create a Slack App → Enable "Incoming Webhooks"
# 2. Add a webhook to your target channel
# 3. Copy the webhook URL here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Synapse (Sage Bionetworks) Personal Access Token
# Required only for the Synapse scraper. Leave blank to skip it.
# How to get one:
#   1. Log in to https://www.synapse.org
#   2. Click your profile icon → Settings → Access Tokens
#   3. Create a token with "View" permission and paste it below
SYNAPSE_AUTH_TOKEN=your_synapse_personal_access_token

# TCIA (The Cancer Imaging Archive) — no credentials required.
# TCIA uses a public REST API accessible without an API key.

# Grand Challenge — no credentials required.
# Grand Challenge uses a public REST API accessible without an API key.

